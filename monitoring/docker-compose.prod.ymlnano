  loki:
    image: grafana/loki:latest
    container_name: ai-sql-loki
    command: -config.file=/etc/loki/loki-config.yml
    ports:
      - "3100:3100"
    volumes:
      - ./monitoring/loki-config.yml:/etc/loki/loki-config.yml:ro
      - loki-data:/loki
    networks:
      - ai-network
    restart: unless-stopped
